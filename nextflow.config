params {
    data_dir = ''
    results_dir = ''
    config_dir = ''
    working_dir = ''
    runtime_opts = ''
    cluster_opts = ''
}
data_dir = params.data_dir
results_dir = params.results_dir ? params.results_dir : data_dir
config_dir = params.config_dir ? params.config_dir : output_dir

profiles {

    localdocker {
        docker {
            enabled = true
        }

        singularity {
            enabled = false
        }
    }

    localsingularity {
        docker {
            enabled = false
        }

        singularity {
            enabled = true
        }
    }

    lsf {
        process {
            executor = 'lsf'
            withLabel: withGPU {
                queue = 'gpu_any'
                cpus = 2
                clusterOptions = '-gpu "num=1" ' + params.cluster_opts
            }

            clusterOptions = params.cluster_opts
        }

        docker {
            enabled = false
        }

        singularity {
            enabled = true
        }

    }
}

docker {
    runOptions = "${params.runtime_opts} -v ${data_dir}:${data_dir} -v ${results_dir}:${results_dir} -v ${config_dir}:${config_dir}"
    temp = "auto"
}

singularity {
    autoMounts = true
    cacheDir = "$HOME/.singularity_cache"
    runOptions = "${params.runtime_opts} --nv -B ${data_dir} -B ${results_dir} -B ${config_dir}"
}
