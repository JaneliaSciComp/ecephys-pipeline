inputDir = params.in
outputDir = "${params.out}" != '' ? "${params.out}" : inputDir
configDir = "${params.config}" != '' ? "${params.config}" : outputDir
docker_runtime = "--runtime=nvidia"

profiles {

    localdocker {
        docker {
            enabled = true
        }

        singularity {
            enabled = false
        }
    }

    localsingularity {
        docker {
            enabled = false
        }

        singularity {
            enabled = true
        }
    }

    lsf {
        process {
            executor = 'lsf'
            withLabel: requireGPU {
                queue = 'gpu_any'
                cpus = 2
                clusterOptions = '-gpu "num=1" -P scicompsoft'
            }

            clusterOptions = '-P scicompsoft'
        }

        docker {
            enabled = false
        }

        singularity {
            enabled = true
        }

    }
}

docker {
    runOptions = '-u $(id -u):$(id -g) ' + "${docker_runtime} -v $inputDir:$inputDir -v $configDir:$configDir -v $outputDir:$outputDir"
    temp = "auto"
}

singularity {
    autoMounts = true
    cacheDir = "$HOME/.singularity_cache"
    runOptions = "--nv -B $inputDir -B $configDir -B $outputDir"
}
